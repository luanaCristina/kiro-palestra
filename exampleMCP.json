{
  "mcpServers": {
    "atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://SEU-DOMINIO.atlassian.net",
        "JIRA_USERNAME": "SEU-EMAIL-ATLASSIAN@EXEMPLO.COM",
        "JIRA_API_TOKEN": "SEU_TOKEN_DA_ATLASSIAN",
        "CONFLUENCE_URL": "https://SEU-DOMINIO.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "SEU-EMAIL-ATLASSIAN@EXEMPLO.COM",
        "CONFLUENCE_API_TOKEN": "SEU_TOKEN_DA_ATLASSIAN"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "SEU_TOKEN_GHP_DO_GITHUB"
      }
    },
    "smartbear": {
      "command": "npx",
      "args": ["-y", "@smartbear/mcp@latest"],
      "env": {
        "QMETRY_API_KEY": "SUA_API_KEY_DO_QMETRY",
        "QMETRY_BASE_URL": "https://testmanagement.qmetry.com"
      }
    }
  }
}